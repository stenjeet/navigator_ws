<?xml version="1.0"?>
<!--
  Individual URDF model of the "Navigator-M" differential-drive robot
  (report section 2). The hull was compacted (radius 0.24 m, height 0.22 m)
  while the running gear and sensor mounts stay unchanged:

    - wheel track L = 0.42 m  -> wheel joints at y = +/- 0.21
    - lidar    at (0.18, 0, 0.34) relative to base_link
    - UWB tag  at (-0.15, 0.12, 0.46) relative to base_link
-->
<robot name="navigator_m">

  <material name="hull"><color rgba="0.82 0.84 0.87 1.0"/></material>
  <material name="black"><color rgba="0.04 0.04 0.04 1.0"/></material>
  <material name="silver"><color rgba="0.65 0.67 0.70 1.0"/></material>
  <material name="red"><color rgba="0.85 0.08 0.08 1.0"/></material>
  <material name="yellow"><color rgba="0.95 0.70 0.05 1.0"/></material>
  <material name="cyan"><color rgba="0.00 0.70 0.85 1.0"/></material>
  <material name="white"><color rgba="0.90 0.90 0.90 1.0"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry><cylinder radius="0.24" length="0.22"/></geometry>
      <material name="hull"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry><cylinder radius="0.24" length="0.22"/></geometry>
    </collision>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="front_panel_link">
    <visual>
      <origin xyz="0.235 0 0.13" rpy="0 0 0"/>
      <geometry><box size="0.04 0.20 0.10"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.235 0 0.13" rpy="0 0 0"/>
      <geometry><box size="0.04 0.20 0.10"/></geometry>
    </collision>
  </link>
  <joint name="front_panel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_panel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.045"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.045"/></geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.21 0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.045"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.09" length="0.045"/></geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.21 0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.045"/></geometry>
    </collision>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.23 0 -0.05" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.045"/></geometry>
    </collision>
  </link>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="-0.23 0 -0.05" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry><cylinder radius="0.075" length="0.09"/></geometry>
      <material name="cyan"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry><cylinder radius="0.075" length="0.09"/></geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.18 0 0.34" rpy="0 0 0"/>
  </joint>

  <link name="uwb_tag_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.09 0.09 0.08"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.09 0.09 0.08"/></geometry>
    </collision>
  </link>
  <joint name="uwb_tag_joint" type="fixed">
    <parent link="base_link"/>
    <child link="uwb_tag_link"/>
    <origin xyz="-0.15 0.12 0.46" rpy="0 0 0"/>
  </joint>

  <link name="computer_link">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry><box size="0.18 0.14 0.07"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry><box size="0.18 0.14 0.07"/></geometry>
    </collision>
  </link>
  <joint name="computer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="computer_link"/>
    <origin xyz="-0.10 -0.10 0.22" rpy="0 0 0"/>
  </joint>

</robot>
